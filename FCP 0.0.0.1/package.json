{
  "name": "bestandsconverter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "dist-electron/electron-main.js",
  "scripts": {
    "dev": "vite",
    "dev-electron": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "vite build && tsc --project tsconfig.electron.json",
    "build-electron": "electron-builder",
    "preview": "vite preview",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@zip.js/zip.js": "^2.8.29",
    "imagetracerjs": "^1.2.6",
    "jspdf": "^4.2.1",
    "libheif-js": "^1.19.8",
    "pdfjs-dist": "^6.1.200",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.4",
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3",
    "ffmpeg-static": "^5.3.0",
    "fluent-ffmpeg": "^2.1.3",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "wait-on": "^8.0.5"
  }
